{{> header}}

<main class="contenedor">
    <h1>{{titulo}}</h1>
    <p>{{objetivoProyecto}}</p>

    <section>
        <h2>Tecnologías</h2>
        <ul>
            {{#each tecnologias}}
            <li>{{this}}</li>
            {{/each}}
        </ul>

        <h2>Estado Actual del Desarrollo</h2>
        <p>Versión: {{estadoActual}}</p>

        <h2>Total de Usuarios</h2>
        <p>Usuarios: {{totalUsuarios}}</p>

    </section>
</main>

{{> footer}}